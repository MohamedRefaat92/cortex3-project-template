Bootstrap: docker
From: rocker/rstudio:4.5.0

%labels
    Author       Mohamed Shoeb
    Version      0.1.0
    Description  Bioinformatics container for cortex3: R + RStudio Server + Python + Jupyter
    R_Version    4.5.0
    Base         rocker/rstudio (debian)

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    # ---- System dependencies -------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential cmake git curl wget ca-certificates \
        python3 python3-dev python3-pip python3-venv \
        libssl-dev libcurl4-openssl-dev libxml2-dev \
        libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
        libpng-dev libjpeg-dev libtiff5-dev \
        libcairo2-dev libxt-dev \
        libhdf5-dev libgsl-dev libudunits2-dev \
        libgdal-dev libproj-dev libgeos-dev \
        libnode-dev \
        less vim nano htop tmux \
        pandoc

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # ---- Python: virtual environment with Jupyter + scientific stack ---
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel
    /opt/venv/bin/pip install --no-cache-dir \
        jupyterlab notebook ipykernel ipywidgets \
        numpy pandas scipy scikit-learn matplotlib seaborn \
        anndata scanpy

    # ---- R: install renv (project-level package management) ------------
    R -e "install.packages('renv', repos='https://cloud.r-project.org')"

    # ---- Make R use the bind-mounted site-library by default -----------
    # The site-library path will be bind-mounted from <project>/R at run time
    mkdir -p /usr/local/lib/R/site-library
    chmod -R 777 /usr/local/lib/R/site-library

%environment
    export PATH=/opt/venv/bin:$PATH
    export R_LIBS_USER=/usr/local/lib/R/site-library
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%runscript
    # Default behavior when invoked without `exec`/`shell`
    echo "Bioinformatics container ($PROJECT_NAME)"
    echo "Available entry points (run with apptainer exec):"
    echo "  R / Rscript           — R session or script"
    echo "  rserver               — RStudio Server (used by scripts/run_rstudio.sh)"
    echo "  python3 / jupyter lab — Python / Jupyter"
    echo "  bash                  — interactive shell"

# =============================================================================
# Project configuration for cortex3 (Ludwig Institute HPC)
# Copy to .env and customize per project. .env is gitignored.
# =============================================================================

# --- Identity ------------------------------------------------------------
PROJECT_NAME=my_first_project
CONTAINER_NAME=bioinfo             # basename of container/<NAME>.def
SSH_ALIAS=ludwig_cluster

# --- Cluster paths -------------------------------------------------------
# /mnt/scratch on cortex3 is a 1.9 PB Lustre filesystem and serves as the
# primary persistent user data location (despite the name).
# /tmp on each node is local NVMe (~11 TB) — fast but ephemeral per-job.
# /users (NFS, your $HOME) is for dotfiles and small configs, NOT data.
PROJECT_PARENT=/mnt/scratch/users/${USER}/projects
APPTAINER_CACHEDIR=/mnt/scratch/users/${USER}/.apptainer-cache
APPTAINER_TMPDIR=/tmp/apptainer-${USER}

# --- SLURM defaults ------------------------------------------------------
# cortex3 has 2 partitions: short (1-day max) and long (21-day max)
# Each node: 64 CPUs, 754 GB RAM, no GPUs.
SLURM_ACCOUNT=default
SLURM_PARTITION_SHORT=short        # default partition, 1-day max walltime
SLURM_PARTITION_LONG=long          # for jobs >1 day, up to 21 days

# Defaults used when a script's --time/--cpus/--mem aren't specified.
# Override per-launch with flags, e.g.: ./scripts/run_rstudio.sh --time=8:00:00
SLURM_DEFAULT_TIME=4:00:00
SLURM_DEFAULT_CPUS=8
SLURM_DEFAULT_MEM=64G

# Heftier defaults for interactive RStudio/Jupyter (real analytical work)
INTERACTIVE_TIME=8:00:00
INTERACTIVE_CPUS=16
INTERACTIVE_MEM=96G

# --- Port assignments (project-unique, for interactive sessions) ---------
# Convention: project N gets ports 88N1..88N9 — pick a free range per project
# Check with: lsof -i -P -n | grep LISTEN | grep $USER
RSTUDIO_PORT=8801                  # forwarded port on YOUR MAC (local end)
JUPYTER_PORT=8802

# --- Inside-container paths ----------------------------------------------
WORKSPACE=/workspace               # where PROJECT_ROOT is bind-mounted
